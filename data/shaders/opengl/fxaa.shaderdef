# Edge smoothing, the simple way: FXAA on the finished picture (ScreenEffects.cpp)
Shader fxaa

Texture sampler2D colourTex

Buffer DrawData binding=1

PushConstant vec4 EdgeScreen binding=0

Vertex "screen_pass.vert"
Fragment "fxaa.frag"
