Shader cloud_shadow

Texture sampler2D sceneDist
Texture sampler2D cloudHeightTex
Texture sampler2D cloudWeatherXY
Texture sampler2D cloudWeatherZ

Buffer LightData binding=0
Buffer DrawData binding=1
Buffer CloudPassData binding=2
Buffer CloudData binding=3

Vertex "cloud_fullscreen.vert"
Fragment "cloud_shadow.frag"
