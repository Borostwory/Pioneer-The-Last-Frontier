# The struts and joints of a city's forcefield dome (CityOnPlanet::RenderForcefields)

Shader forcefield_struts

Buffer LightData binding=0
Buffer DrawData binding=1
Buffer ForcefieldData binding=2

Vertex "forcefield_struts.vert"
Fragment "forcefield_struts.frag"
