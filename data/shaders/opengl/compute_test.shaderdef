# P6 of the OpenGL 4.6 plan: a compute shader that fills an image, to show compute runs (OpenGL 4.6 Plan tab)
Shader compute_test

Buffer DrawData binding=1

Image image2D outImage binding=0 format=rgba16f access=write
PushConstant float Time binding=0

Compute "compute_test.comp"
