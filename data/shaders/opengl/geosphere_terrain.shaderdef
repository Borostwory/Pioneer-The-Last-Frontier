Shader geosphere_terrain

Texture sampler2D texture0
Texture sampler2D texture1

Texture sampler2D cloudHeightTex
Texture sampler2D waterWaves
Texture sampler2DArray terrainMaterials
Texture sampler2DArray terrainStoneHeights
Texture sampler2D terrainRelief
Texture sampler2D terrainTiles
Texture sampler2D surfaceTileColour
Texture sampler2D surfaceTileNormal

Texture sampler2D shadowMapNear
Texture sampler2D shadowMapMid
Texture sampler2D shadowMapFar

Texture sampler2D cityRoads
Texture sampler2D cityLots

Texture sampler2D wheelTracks
Texture sampler2D footTracks

Buffer LightData binding=0
Buffer DrawData binding=1
Buffer BaseSphereData binding=2
Buffer CloudData binding=3
Buffer ShadowData binding=4
Buffer CityGroundData binding=7
Buffer ShipLightData binding=8
Buffer SurfaceTrackData binding=9

PushConstant int NumShadows binding=0
PushConstant float PatchDetailFrequency binding=1
PushConstant vec4 SurfaceMaterial binding=2
PushConstant vec4 WaterOrigin binding=3
PushConstant vec4 WaterDrift binding=4
PushConstant vec4 MaterialOrigin binding=5
PushConstant vec4 MaterialOriginCoarse binding=6
PushConstant vec4 MaterialSlots0 binding=7
PushConstant vec4 MaterialSlots1 binding=8
PushConstant vec4 MaterialSpecial binding=9
PushConstant vec4 ReliefScale binding=10
PushConstant vec4 PatchTile binding=11
PushConstant vec4 FarTexture binding=12
PushConstant vec4 PatchSurface binding=13
PushConstant vec4 MaterialSlots2 binding=14
PushConstant vec4 MaterialSlots3 binding=15
PushConstant vec4 MaterialLook binding=16
PushConstant vec4 TessParams binding=17
PushConstant vec4 TessScreen binding=18
PushConstant vec4 MaterialNear binding=19
PushConstant vec4 MaterialStones binding=20
PushConstant vec4 StoneFlat0 binding=21
PushConstant vec4 StoneFlat1 binding=22
PushConstant vec4 StoneFlat2 binding=23
PushConstant vec4 StoneFlat3 binding=24
PushConstant vec4 StoneFlat4 binding=25
PushConstant vec4 StoneFlat5 binding=26

Vertex "geosphere_terrain.vert"
Fragment "geosphere_terrain.frag"
# near the camera, with Material::SetTessellated (P4a of the OpenGL 4.6 plan)
TessControl "geosphere_terrain.tesc"
TessEval "geosphere_terrain.tese"
