Shader rayleigh_geosphere_sky_full

Texture sampler2D densityLUT
Texture sampler2D scatterLUT
Texture sampler2D skyTable

Buffer LightData binding=0
Buffer DrawData binding=1
Buffer BaseSphereData binding=2

PushConstant int NumShadows binding=0
PushConstant vec4 SkyTable binding=1

Vertex "rayleigh_geosphere_sky_full.vert"
Fragment "rayleigh_geosphere_sky_full.frag"
