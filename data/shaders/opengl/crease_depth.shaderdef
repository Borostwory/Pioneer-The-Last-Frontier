# Crease shading, step 1: the scene's distance from the camera, pixel by pixel (ScreenEffects.cpp)
Shader crease_depth

Texture sampler2D sceneDepth

Buffer DrawData binding=1

PushConstant vec4 CreaseProj binding=0

Vertex "screen_pass.vert"
Fragment "crease_depth.frag"
