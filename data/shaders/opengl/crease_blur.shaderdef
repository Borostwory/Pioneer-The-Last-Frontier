# Crease shading, step 3: the shade evened out (ScreenEffects.cpp)
Shader crease_blur

Texture sampler2D sceneDist
Texture sampler2D creaseTex

Buffer DrawData binding=1

PushConstant vec4 CreaseProj binding=0
PushConstant vec4 CreaseScreen binding=1
PushConstant vec4 CreaseParams binding=2

Vertex "screen_pass.vert"
Fragment "crease_blur.frag"
