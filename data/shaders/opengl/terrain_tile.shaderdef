PushConstant vec4 TileCorner3 binding=4
PushConstant vec4 TileCentre binding=5
PushConstant vec4 TileOctaves binding=6
PushConstant vec4 TileOrigin binding=7
PushConstant vec4 TileStyle binding=8

Vertex "cloud_fullscreen.vert"
Fragment "terrain_tile.frag"
