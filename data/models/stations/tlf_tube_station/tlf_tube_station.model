	shader "multi"
	specular 0.8 0.8 0.8
	shininess 60
	texture diffuse "tlf_tube_fac_res_beige_d.dds"
	texture specular "tlf_tube_fac_res_beige_s.dds"
	texture glow "tlf_tube_fac_res_beige_g.dds"
	texture ambient "tlf_tube_fac_res_beige_a.dds"
	texture normal "tlf_tube_fac_res_beige_n.dds"
}

