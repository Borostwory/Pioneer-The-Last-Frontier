version 2

material "tlf_tube_station_hull" {
	shader "multi"
	specular 0.7 0.7 0.7
	shininess 60
	texture diffuse "tlf_tube_hull_d.dds"
	texture specular "tlf_tube_hull_s.dds"
	texture glow "tlf_tube_hull_g.dds"
	texture ambient "tlf_tube_hull_a.dds"
	texture normal "tlf_tube_hull_n.dds"
}

material "tlf_tube_station_ground" {
	shader "multi"
	specular 0.5 0.5 0.5
	shininess 20
	texture diffuse "tlf_tube_ground_d.dds"
	texture specular "tlf_tube_ground_s.dds"
	texture glow "tlf_tube_ground_g.dds"
	texture ambient "tlf_tube_ground_a.dds"
	texture normal "tlf_tube_ground_n.dds"
}

material "tlf_tube_station_trim" {
	shader "multi"
	specular 0.6 0.6 0.6
	shininess 60
	texture diffuse "tlf_tube_trim_d.dds"
	texture specular "tlf_tube_trim_s.dds"
	texture glow "tlf_tube_trim_g.dds"
	texture ambient "tlf_tube_trim_a.dds"
	texture normal "tlf_tube_trim_n.dds"
}

material "tlf_tube_station_spoke" {
	shader "multi"
	specular 0.7 0.7 0.7
	shininess 60
	texture diffuse "tlf_tube_spoke_d.dds"
	texture specular "tlf_tube_spoke_s.dds"
	texture glow "tlf_tube_spoke_g.dds"
	texture ambient "tlf_tube_spoke_a.dds"
	texture normal "tlf_tube_spoke_n.dds"
}

material "tlf_tube_station_glass" {
	shader "multi"
	opacity 99
	texture diffuse "tlf_tube_glass_d.dds"
	texture specular "tlf_tube_glass_s.dds"
	texture glow "tlf_tube_glass_g.dds"
	texture ambient "tlf_tube_glass_a.dds"
	texture normal "tlf_tube_glass_n.dds"

	render_state {
		blend alpha
		depth_write off
	}
}

material "tlf_tube_station_sun" {
	shader "multi"
	specular 0.2 0.2 0.2
	shininess 10
	texture diffuse "tlf_tube_sun_d.dds"
	texture specular "tlf_tube_sun_s.dds"
	texture glow "tlf_tube_sun_g.dds"
	texture ambient "tlf_tube_sun_a.dds"
	texture normal "tlf_tube_sun_n.dds"
}

