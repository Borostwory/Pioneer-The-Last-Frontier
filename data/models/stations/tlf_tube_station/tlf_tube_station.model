	shader "multi"
	specular 0.8 0.8 0.8
	shininess 60
	texture diffuse "tlf_tube_fac_office_dark_d.dds"
	texture specular "tlf_tube_fac_office_dark_s.dds"
	texture glow "tlf_tube_fac_office_dark_g.dds"
	texture ambient "tlf_tube_fac_office_dark_a.dds"
	texture normal "tlf_tube_fac_office_dark_n.dds"
