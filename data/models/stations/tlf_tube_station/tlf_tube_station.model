	shader "multi"
	specular 0.8 0.8 0.8
	shininess 60
	texture diffuse "tlf_tube_fac_glass_blue_d.dds"
	texture specular "tlf_tube_fac_glass_blue_s.dds"
	texture glow "tlf_tube_fac_glass_blue_g.dds"
	texture ambient "tlf_tube_fac_glass_blue_a.dds"
	texture normal "tlf_tube_fac_glass_blue_n.dds"
}

material "tlf_tube_station_bld_glass_bronze" {
	shader "multi"
	specular 0.8 0.8 0.8
	shininess 60
	texture diffuse "tlf_tube_fac_glass_bronze_d.dds"
	texture specular "tlf_tube_fac_glass_bronze_s.dds"
	texture glow "tlf_tube_fac_glass_bronze_g.dds"
	texture ambient "tlf_tube_fac_glass_bronze_a.dds"
	texture normal "tlf_tube_fac_glass_bronze_n.dds"
}

material "tlf_tube_station_bld_office_light" {
	shader "multi"
	specular 0.8 0.8 0.8
	shininess 60
	texture diffuse "tlf_tube_fac_office_light_d.dds"
	texture specular "tlf_tube_fac_office_light_s.dds"
	texture glow "tlf_tube_fac_office_light_g.dds"
	texture ambient "tlf_tube_fac_office_light_a.dds"
	texture normal "tlf_tube_fac_office_light_n.dds"
