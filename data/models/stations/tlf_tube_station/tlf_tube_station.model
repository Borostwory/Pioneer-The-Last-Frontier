	shader "multi"
	specular 0.8 0.8 0.8
	shininess 60
	texture diffuse "tlf_tube_fac_res_brick_d.dds"
	texture specular "tlf_tube_fac_res_brick_s.dds"
	texture glow "tlf_tube_fac_res_brick_g.dds"
	texture ambient "tlf_tube_fac_res_brick_a.dds"
	texture normal "tlf_tube_fac_res_brick_n.dds"
}

material "tlf_tube_station_bld_roof" {
	shader "multi"
	specular 0.5 0.5 0.5
	shininess 30
	texture diffuse "tlf_tube_roof_d.dds"
	texture specular "tlf_tube_roof_s.dds"
	texture glow "tlf_tube_roof_g.dds"
	texture ambient "tlf_tube_roof_a.dds"
	texture normal "tlf_tube_roof_n.dds"
}

material "tlf_tube_station_field" {
	shader "multi"
	specular 0.6 0.6 0.6
	shininess 80
	opacity 99
	texture diffuse "tlf_tube_field_d.dds"
	texture specular "tlf_tube_field_s.dds"
	texture glow "tlf_tube_field_g.dds"

	render_state {
		blend alpha
		depth_write off
	}
}

material "tlf_tube_station_hall" {
	shader "multi"
	specular 0.4 0.4 0.4
	shininess 40
	texture diffuse "tlf_tube_hall_d.dds"
	texture specular "tlf_tube_hall_s.dds"
	texture glow "tlf_tube_hall_g.dds"
	texture ambient "tlf_tube_hall_a.dds"
	texture normal "tlf_tube_hall_n.dds"
}

material "tlf_tube_station_pad" {
	shader "multi"
	specular 0.4 0.4 0.4
	shininess 20
	texture diffuse "tlf_tube_pad_d.dds"
	texture specular "tlf_tube_pad_s.dds"
	texture glow "tlf_tube_pad_g.dds"
	texture ambient "tlf_tube_pad_a.dds"
	texture normal "tlf_tube_pad_n.dds"
}

material "tlf_tube_station_padnum" {
	shader "multi"
	specular 0.3 0.3 0.3
	shininess 20
	texture diffuse "tlf_tube_padnum_d.dds"
	texture specular "tlf_tube_padnum_s.dds"
	texture glow "tlf_tube_padnum_g.dds"

	alpha_test
}

material "tlf_tube_station_road" {
	shader "multi"
	specular 0.4 0.4 0.4
	shininess 10
	texture diffuse "tlf_tube_road_d.dds"
	texture specular "tlf_tube_road_s.dds"
	texture glow "tlf_tube_road_g.dds"
	texture ambient "tlf_tube_road_a.dds"
	texture normal "tlf_tube_road_n.dds"
}

lod 500 {
	mesh "tlf_tube_station_500.dae"
	mesh "tlf_tube_station_docking.dae"
}

lod 100 {
	mesh "tlf_tube_station_100.dae"
}

lod 15 {
	mesh "tlf_tube_station_15.dae"
}

bound capsule interior "tag_interior0" "tag_interior1" 45
bound capsule interior "tag_interior1" "tag_interior2" 150
bound capsule interior "tag_interior2" "tag_interior3" 45

collision "tlf_tube_station_collision.dae"
