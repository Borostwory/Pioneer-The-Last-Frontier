lod 1000 {
	mesh "olympus_village_1000.dae"
	mesh "olympus_village_landing.dae"
}

lod 150 {
	mesh "olympus_village_150.dae"
}

lod 25 {
	mesh "olympus_village_25.dae"
}

collision "olympus_village_collision.dae"
