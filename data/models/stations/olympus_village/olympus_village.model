version 2

material "ov_concrete_slab" {
	shader "multi"
	shininess 20
	texture diffuse "ov_concrete_diff.dds"
	texture specular "ov_concrete_spec.dds"
	texture glow "ov_concrete_glow.dds"
	texture normal "ov_concrete_norm.dds"
	texture ambient "ov_concrete_ao.dds"
}

material "ov_pad" {
	shader "multi"
	shininess 25
	texture diffuse "ov_pad_diff.dds"
	texture specular "ov_pad_spec.dds"
	texture glow "ov_pad_glow.dds"
	texture normal "ov_pad_norm.dds"
	texture ambient "ov_pad_ao.dds"
}

